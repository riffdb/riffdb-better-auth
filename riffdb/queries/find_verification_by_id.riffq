query FindVerificationById(
    $organization_id: Verification.organization_id,
    $id: Verification.verification_id,
) {
    one verification from Verification
        where organization_id == $organization_id
          && verification_id == $id
        else Missing

    return Found {
        verification: verification {
            verification_id identifier
            value reveals verification.value
            expires_at created_at updated_at revision
        }
    }

    outcomes Found | Missing
}
