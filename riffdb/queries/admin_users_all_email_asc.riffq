query AdminUsersAllEmailAsc(
    $organization_id: User.organization_id,
    $minimum_email: User.email,
    $user_id: User.user_id?,
    $limit: Limit<100> = 50,
    $offset: u64 = 0
) {
    many users from User
        where organization_id == $organization_id
          && email >= $minimum_email
          && when $user_id { user_id == $user_id }
        order by email asc, user_id asc
        take $limit offset $offset

    aggregate total from users { exact_count() as value }

    return Found {
        users: users {
            organization_id user_id name email email_verified image created_at updated_at revision
        }
        total: total { value }
    }
    outcomes Found
}
