query FindAccountById(
    $organization_id: Account.organization_id,
    $id: Account.id,
) {
    many accounts from Account
        where organization_id == $organization_id
          && id == $id
        order by user_id asc
        take 1

    return Found {
        accounts: accounts {
            id user_id account_id provider_id
            access_token reveals accounts.access_token
            refresh_token reveals accounts.refresh_token
            access_token_expires_at refresh_token_expires_at scope
            id_token reveals accounts.id_token
            password reveals accounts.password
            created_at updated_at revision
        }
    }

    outcomes Found
}
