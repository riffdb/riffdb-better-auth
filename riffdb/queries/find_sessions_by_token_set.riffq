query FindSessionsByTokenSet(
    $organization_id: Session.organization_id,
    $tokens: Set<Session.token>,
) {
    many sessions from Session
        where organization_id == $organization_id
          && token in $tokens
        order by token asc, user_id asc, id asc
        take 32

    return Found {
        sessions: sessions {
            id user_id
            token reveals sessions.token
            expires_at ip_address user_agent created_at updated_at revision
        }
    }

    outcomes Found
}
