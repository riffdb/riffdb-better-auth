{
  "name": "@riffdb/better-auth",
  "version": "0.1.0-dev.1",
  "description": "A compiled-profile Better Auth adapter for RiffDB",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "generated",
    "riffdb",
    "riffdb.application.json",
    "riffdb.application.lock.json",
    "scripts/real-riffdb-runner.mjs",
    "README.md",
    "DESIGN.md",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm pack --dry-run --cache ./node_modules/.cache/npm",
    "prepack": "npm run build",
    "start": "node scripts/real-riffdb-runner.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@riffdb/client": "0.1.0-dev.6",
    "better-auth": "1.6.29"
  },
  "dependencies": {
    "@riffdb/client": "0.1.0-dev.6"
  },
  "devDependencies": {
    "@better-auth/test-utils": "1.6.29",
    "@riffdb/cli": "0.1.0-dev.6",
    "@types/node": "26.2.0",
    "better-auth": "1.6.29",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT OR Apache-2.0",
  "sideEffects": false
}
