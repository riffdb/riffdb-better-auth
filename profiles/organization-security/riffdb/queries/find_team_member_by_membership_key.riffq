query FindTeamMemberByMembershipKey(
    $tenant_id: TeamMember.tenant_id,
    $membership_key: TeamMember.membership_key,
) {
    many team_members from TeamMember
        where tenant_id == $tenant_id
          && membership_key == $membership_key
        order by user_id asc, team_member_id asc
        take 1

    return Found {
        team_members: team_members { user_id team_member_id created_at membership_key reveals team_members.membership_key team_id revision }
    }

    outcomes Found
}
