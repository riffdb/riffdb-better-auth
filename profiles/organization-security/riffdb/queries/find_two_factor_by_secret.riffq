query FindTwoFactorBySecret(
    $tenant_id: TwoFactor.tenant_id,
    $secret: TwoFactor.secret,
    $after: Cursor?,
) {
    many two_factors from TwoFactor
        where tenant_id == $tenant_id
          && secret == $secret
        order by user_id asc, two_factor_id asc
        take 50 after $after

    return Found {
        two_factors: two_factors { user_id two_factor_id backup_codes reveals two_factors.backup_codes failed_verification_count reveals two_factors.failed_verification_count locked_until reveals two_factors.locked_until secret reveals two_factors.secret verified revision }
    }

    outcomes Found
}
