query ProfileMemberByOrganizationCreatedAtDesc(
    $organization_id: Member.organization_id,
    $org_id: Member.org_id,
    $minimum_role: Member.role = "",
    $limit: Limit<100> = 100,
    $offset: u64 = 0
) {
    many rows from Member
        where organization_id == $organization_id && org_id == $org_id && role >= $minimum_role
        order by created_at desc, member_id asc
        take $limit offset $offset

    aggregate total from rows { exact_count() as value }

    return Found {
        rows: rows { member_id created_at org_id role user_id revision }
        total: total { value }
    }
    outcomes Found
}
