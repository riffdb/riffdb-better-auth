query ProfileSessionWithUserById($organization_id: Session.organization_id, $value: Session.id) {
    one session from Session
        where organization_id == $organization_id && id == $value
        else Missing
    one user from User
        where organization_id == $organization_id && user_id == session.user_id
        else IntegrityFailure
    return Found { session: session {
            id user_id
            token reveals session.token
            expires_at ip_address user_agent created_at updated_at revision
         active_organization_id  } user: user {  user_id name email email_verified image created_at updated_at revision  date_field locale two_factor_enabled  } }
    outcomes Found | Missing | IntegrityFailure
}
