query ProfileAccountWithUserByProvider(
    $organization_id: Account.organization_id,
    $account_id: Account.account_id,
    $provider_id: Account.provider_id,
) {
    many accounts from Account
        where organization_id == $organization_id
          && provider_id == $provider_id
          && account_id == $account_id
        order by user_id asc, id asc
        take 1

    many users from User
        where organization_id == $organization_id && user_id in distinct(accounts.user_id)
        take 1

    return Found {
        users: users {  user_id name email email_verified image created_at updated_at revision  date_field locale  }
        accounts: accounts {
            id user_id account_id provider_id
            access_token reveals accounts.access_token
            refresh_token reveals accounts.refresh_token
            access_token_expires_at refresh_token_expires_at scope
            id_token reveals accounts.id_token
            password reveals accounts.password
            created_at updated_at revision
          }
    }

    outcomes Found
}
